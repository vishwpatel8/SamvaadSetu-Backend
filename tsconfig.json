{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // Environment Settings
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,

    "paths": {
      "@src/*": ["./src/*"]
    },
    "types": ["node"],

    // Other Outputs
    "sourceMap": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true
  },

  "include": ["src"]
}
